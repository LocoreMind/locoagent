# LocoAgent configuration — copy to .env (the installer does this for you).
# Only the API key is strictly required; everything else has working defaults.

# ── LLM provider (the only block most people need) ──────────────────────────
# Pick ONE provider, give it a key, optionally pick a model. These four neutral
# LLM_* variables are translated to the right internal settings at startup, so
# you never have to think about which provider uses which legacy variable name.
#
#   LLM_PROVIDER : deepseek | openai | anthropic | custom
#   LLM_API_KEY  : your key for that provider
#   LLM_MODEL    : model id (leave blank for the provider's sensible default)
#   LLM_BASE_URL : only needed for `custom` / self-hosted OpenAI-compatible APIs
#
# Examples:
#   DeepSeek  → LLM_PROVIDER=deepseek   LLM_MODEL=deepseek-chat
#   OpenAI    → LLM_PROVIDER=openai     LLM_MODEL=gpt-5.5
#   Anthropic → LLM_PROVIDER=anthropic  LLM_MODEL=claude-sonnet-4-6
#   Custom    → LLM_PROVIDER=custom     LLM_BASE_URL=http://localhost:1234/v1
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_BASE_URL=

# ── Advanced / compatibility (leave blank if you used LLM_* above) ───────────
# These are the underlying variables the LLM_* block maps onto. They still work
# directly for existing setups and power users; an explicitly-set value here
# always wins over the LLM_* front door. DeepSeek, OpenAI, and any other
# OpenAI-compatible provider all share the OPENAI_* namespace below — the actual
# provider is decided by OPENAI_BASE_URL + OPENAI_MODEL, not by the variable name.
#
# CLAUDE_CODE_USE_OPENAI=1            # 1 = use the OpenAI-compatible shim; empty = native Anthropic SDK
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_MODEL=deepseek-chat
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=

# ── Windows runtime ─────────────────────────────────────────────────────────
# Absolute path to git-bash (bash.exe). install.ps1 auto-detects this when it can.
CLAUDE_CODE_GIT_BASH_PATH=

# ── TLS / proxy (corporate VPN, campus FortiGate, Zscaler, …) ───────────────
# If you see "unable to get local issuer certificate" / "untrusted root", your
# network is re-signing TLS. Export the gateway's root CA to a .pem file and put
# its absolute path here; LocoAgent will trust it on every provider path.
#   Windows: certmgr.msc → Trusted Root CAs → export the proxy CA as Base-64 .cer
#   macOS:   Keychain Access → export the proxy CA as .pem
NODE_EXTRA_CA_CERTS=

# ── Chrome / CDP ────────────────────────────────────────────────────────────
# All optional — scripts/lib/host.ts auto-detects sane per-OS defaults.
# `bun run setup-chrome` launches a FRESH, ISOLATED, PERSISTENT Chrome profile
# (never your real one) with CDP on, so it never conflicts with your everyday
# Chrome. Log into your socials ONCE in that window; the session persists. Use
# `bun run setup-chrome --reset` to wipe the isolated profile and log in fresh.
#
# DEVICE_PROFILE: desktop | ios | android   (browser emulation target)
DEVICE_PROFILE=desktop
# CDP remote-debugging port used by setup-chrome + agent-browser.
CHROME_DEBUG_PORT=9222
# Override Chrome binary path only if auto-detection fails.
CHROME_BIN=
# The isolated, persistent work profile dir. Leave blank for the per-user default
# (%LOCALAPPDATA%\locoagent-chrome-profile on Windows, ~/Library/Application
# Support/locoagent-chrome-profile on macOS, $XDG_DATA_HOME on Linux).
CHROME_WORK_PROFILE=

# ── Permissions ─────────────────────────────────────────────────────────────
# Set to 1 to auto-pass --dangerously-skip-permissions (see stubs/globals.ts).
SKIP_PERMISSIONS=
